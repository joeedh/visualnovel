{
  "name": "@vn/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "VN Studio — write, generate and play a visual novel.",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "check": "pnpm build:pathux-types && tsgo --noEmit -p renderer/tsconfig.json",
    "build:pathux-types": "tsgo -p pathux-types.tsconfig.json",
    "build:main": "node ../../scripts/esbuild.desktop.mjs",
    "build:renderer": "vite build",
    "build:catalog": "node ../../scripts/gen-command-catalog.mjs",
    "check:setup": "node ../../scripts/check-submodules.mjs",
    "build": "pnpm check:setup && pnpm build:main && pnpm build:catalog && pnpm build:renderer",
    "dev": "node ../../scripts/dev.desktop.mjs",
    "dev:renderer": "vite",
    "start": "electron .",
    "package": "pnpm build && node ../../scripts/package.desktop.mjs",
    "package:dir": "pnpm build && node ../../scripts/package.desktop.mjs --dir",
    "smoke": "node ../../scripts/smoke.desktop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^0.3.0",
    "@vn/agentreport": "workspace:*",
    "@vn/artgen": "workspace:*",
    "@vn/authoring": "workspace:*",
    "@vn/bible": "workspace:*",
    "@vn/commands": "workspace:*",
    "@vn/config": "workspace:*",
    "@vn/debug2d": "workspace:*",
    "@vn/export": "workspace:*",
    "@vn/git": "workspace:*",
    "@vn/model": "workspace:*",
    "@vn/parse": "workspace:*",
    "@vn/pipeline": "workspace:*",
    "@vn/providers": "workspace:*",
    "@vn/scheduler": "workspace:*",
    "@vn/scriptedit": "workspace:*",
    "@vn/store": "workspace:*",
    "@vn/taskgraph": "workspace:*",
    "@vn/types": "workspace:*",
    "@vn/util": "workspace:*",
    "nstructjs": "^0.8.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3"
  }
}
