{
  "name": "@vn/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "check": "tsgo --noEmit -p renderer/tsconfig.json",
    "build:main": "node ../../scripts/esbuild.desktop.mjs",
    "build:renderer": "vite build",
    "build:catalog": "node ../../scripts/gen-command-catalog.mjs",
    "build": "pnpm build:main && pnpm build:catalog && pnpm build:renderer",
    "dev": "node ../../scripts/dev.desktop.mjs",
    "dev:renderer": "vite",
    "start": "electron ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^0.3.0",
    "@vn/authoring": "workspace:*",
    "@vn/commands": "workspace:*",
    "@vn/config": "workspace:*",
    "@vn/debug2d": "workspace:*",
    "@vn/export": "workspace:*",
    "@vn/git": "workspace:*",
    "@vn/model": "workspace:*",
    "@vn/parse": "workspace:*",
    "@vn/pipeline": "workspace:*",
    "@vn/providers": "workspace:*",
    "@vn/scheduler": "workspace:*",
    "@vn/scriptedit": "workspace:*",
    "@vn/store": "workspace:*",
    "@vn/taskgraph": "workspace:*",
    "@vn/types": "workspace:*",
    "@vn/util": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "vite": "^6.0.3"
  }
}
