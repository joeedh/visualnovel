{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "../../vendor/path.ux/scripts",
    "declarationDir": "dist/pathux-types",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "types": []
  },
  "files": ["../../vendor/path.ux/scripts/pathux.ts"]
}
