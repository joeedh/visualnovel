{
  "$schema"        : "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target"             : "ES2022",
    "module"             : "ES2022",
    "moduleResolution"   : "bundler",
    "strict"             : true,
    "esModuleInterop"    : true,
    "allowJs"            : true,
    "checkJs"            : false,
    "skipLibCheck"       : true,
    "declaration"        : true,
    "declarationMap"     : true,
    "emitDeclarationOnly": true,
    "rootDir"            : "../../vendor/path.ux/scripts",
    "declarationDir"     : "dist/pathux-types",
    "lib"                : ["ESNext", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "types"              : [],
    "paths": {
      // path.ux imports nstructjs, and its own install puts the published package in
      // `vendor/path.ux/node_modules`. This declaration build reads the submodule instead, so
      // the types behind `pathux.d.ts` match what vite bundles.
      "nstructjs": ["../../vendor/nstructjs/build/structjs.d.ts"]
    }
  },
  // The barrel reaches none of the rich text editor's markdown or form modules, so each one
  // the renderer aliases is listed here, or its declarations are never emitted.
  "files": [
    "../../vendor/path.ux/scripts/pathux.ts",
    "../../vendor/path.ux/scripts/widgets/richtext/markdown.ts",
    "../../vendor/path.ux/scripts/widgets/richtext/form_native.ts",
    "../../vendor/path.ux/scripts/widgets/richtext/form_zod.ts",
    "../../vendor/path.ux/scripts/widgets/richtext/form_schema.ts",
    "../../vendor/path.ux/scripts/widgets/richtext/headless.ts"
  ]
}
