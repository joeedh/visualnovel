{
  "extends"        : "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@vn/types"           : ["./packages/types/src/index.ts"],
      "@vn/util"            : ["./packages/util/src/index.ts"],
      "@vn/config"          : ["./packages/config/src/index.ts"],
      "@vn/parse"           : ["./packages/parse/src/index.ts"],
      "@vn/model"           : ["./packages/model/src/index.ts"],
      "@vn/store"           : ["./packages/store/src/index.ts"],
      "@vn/export"          : ["./packages/export/src/index.ts"],
      "@vn/scriptedit"      : ["./packages/scriptedit/src/index.ts"],
      "@vn/scriptedit/write": ["./packages/scriptedit/src/write.ts"],
      "@vn/bible"           : ["./packages/bible/src/index.ts"],
      "@vn/artgen"          : ["./packages/artgen/src/index.ts"],
      "@vn/artgen/slotaddr" : ["./packages/artgen/src/slotaddr.ts"],
      "@vn/git"             : ["./packages/git/src/index.ts"],
      "@vn/commands"        : ["./packages/commands/src/index.ts"],
      "@vn/agentreport"     : ["./packages/agentreport/src/index.ts"],
      "@vn/debug2d"         : ["./packages/debug2d/src/index.ts"],
      "@vn/authoring"       : ["./packages/authoring/src/index.ts"],
      "@vn/taskgraph"       : ["./packages/taskgraph/src/index.ts"],
      "@vn/providers"       : ["./packages/providers/src/index.ts"],
      "@vn/pipeline"        : ["./packages/pipeline/src/index.ts"],
      "@vn/scheduler"       : ["./packages/scheduler/src/index.ts"],
      "@vn/testkit"         : ["./packages/testkit/src/index.ts"],
      "@vn/gengraph"        : ["./packages/gengraph/src/index.ts"],
      "@vn/gengraph/state"  : ["./packages/gengraph/src/state.ts"],
      "@vn/gengraph/plugin" : ["./packages/gengraph/src/plugin.ts"],
      "@vn/cli"             : ["./apps/cli/src/index.ts"],
      "pathux-graph"        : ["./apps/desktop/dist/pathux-types/graph/index.d.ts"],
      "pathux-base-types"   : ["./apps/desktop/dist/pathux-types/core/base/ui_base_types.d.ts"],
      "pathux-toolprop": ["./apps/desktop/dist/pathux-types/path-controller/toolsys/toolprop.d.ts"],
      "nstructjs"           : ["./vendor/nstructjs/build/structjs.d.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "plugins/*/**/*.ts",
    "scripts/**/*.ts"
  ]
}
