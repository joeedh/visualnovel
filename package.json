{
  "name": "visualnovel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VN Generator — turns authored inputs into a deduped, resumable pipeline of generated art assets + provenance manifest.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "comment-lint",
      "electron",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "nstructjs": "link:./vendor/nstructjs"
    }
  },
  "scripts": {
    "check": "pnpm --filter @vn/desktop build:pathux-types && tsgo --noEmit -p tsconfig.json && pnpm check:renderer",
    "typecheck": "pnpm --filter @vn/desktop build:pathux-types && tsgo --noEmit -p tsconfig.json && pnpm check:renderer",
    "check:renderer": "pnpm --filter @vn/desktop check",
    "check:setup": "node scripts/check-submodules.mjs",
    "test": "jest",
    "lint": "eslint --cache . && pnpm format:check && pnpm check:doclinks && pnpm lint:comments && pnpm lint:claudemd",
    "lint:comments": "commentlint .",
    "lint:claudemd": "node ./node_modules/comment-lint/bin/commentlint.js CLAUDE.md --disable-rule P4 --disable-rule P10",
    "check:doclinks": "node scripts/check-doc-links.mjs",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "markdown-toc": "node scripts/markdown-toc.mjs",
    "build": "turbo run build",
    "build:cli": "turbo run build --filter=@vn/cli",
    "build:authoring": "turbo run build --filter=@vn/authoring-app",
    "build:desktop": "turbo run build --filter=@vn/desktop",
    "vngen": "node apps/cli/dist/cli.js",
    "vnauthor": "node apps/authoring/dist/vnauthor.js",
    "vndesktop": "node scripts/vndesktop.mjs",
    "vndesktop:dev": " pnpm --filter @vn/desktop dev",
    "package": "pnpm --filter @vn/desktop package",
    "package:dir": "pnpm --filter @vn/desktop package:dir",
    "smoke": "pnpm --filter @vn/desktop smoke",
    "check:keylinks": "node scripts/check-key-links.mjs",
    "audit:keydocs": "node scripts/audit-key-instructions.mjs",
    "setup:all": "git submodule update --init --recursive  && pnpm install && pnpm --dir vendor/path.ux install  && pnpm check:setup"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.2",
    "@typescript/native-preview": "latest",
    "comment-lint": "^0.3.3",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "markdown-toc": "^1.2.0",
    "prettier": "^3.4.2",
    "turbo": "^2.10.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "ws": "^8.21.1"
  }
}
