{
  "extends"  : "lintrix:recommended",
  "plugins": {
    "vn": "./scripts/lintrix/index.ts"
  },
  "rules": {
    "prefer-const"        : "error",
    "no-unsafe-assignment": "error",
    "eqeqeq"              : "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "vn/contract-decl"    : "error",
    "vn/contract-pins"    : "error"
  },
  "overrides": [
    {
      "files": ["packages/**/*.ts", "apps/**/*.ts"],
      "rules": {
        "vn/no-cycle"     : "error",
        "vn/element-types": [
          "error",
          {
            "elements": {
              "contracts"         : "packages/contracts",
              "types"             : "packages/types",
              "types-script"      : "packages/types/src/script",
              "types-production"  : "packages/types/src/production",
              "util"              : "packages/util",
              "config"            : "packages/config",
              "parse"             : "packages/parse",
              "model"             : "packages/model",
              "store"             : "packages/store",
              "export"            : "packages/export",
              "scriptedit"        : "packages/scriptedit",
              "bible"             : "packages/bible",
              "artgen"            : "packages/artgen",
              "artgen-adopt"      : "packages/artgen/src/adopt.ts",
              "stills"            : "packages/stills",
              "gengraph"          : "packages/gengraph",
              "git"               : "packages/git",
              "commands"          : "packages/commands",
              "agentreport"       : "packages/agentreport",
              "debug2d"           : "packages/debug2d",
              "authoring"         : "packages/authoring",
              "taskgraph"         : "packages/taskgraph",
              "taskgraph-write"   : "packages/taskgraph/src/write.ts",
              "taskgraph-maintain": "packages/taskgraph/src/maintain.ts",
              "providers"         : "packages/providers",
              "pipeline"          : "packages/pipeline",
              "scheduler"         : "packages/scheduler",
              "testkit"           : "packages/testkit",
              "cli"               : "apps/cli",
              "authoring-app"     : "apps/authoring",
              "desktop"           : "apps/desktop",
              "pathux"            : "apps/desktop/dist/pathux-types"
            },
            "allow": {
              "contracts"         : [],
              "types"             : ["contracts", "types-script", "types-production"],
              "types-script"      : ["types", "contracts"],
              "types-production"  : ["types", "types-script", "contracts"],
              "util"              : ["types", "contracts"],
              "config"            : ["types", "util", "contracts"],
              "parse"             : ["types", "util", "contracts"],
              "model"             : ["types", "util", "parse", "contracts"],
              "store"             : ["types", "util", "parse", "contracts"],
              "export"            : ["types", "util", "parse", "model", "store", "contracts"],
              "scriptedit"        : ["types", "util", "parse", "model", "store", "contracts"],
              "bible"             : ["types", "util", "parse", "store", "contracts"],
              "stills": [
                "types",
                "util",
                "config",
                "parse",
                "model",
                "store",
                "taskgraph",
                "contracts"
              ],
              "artgen": [
                "types",
                "util",
                "config",
                "parse",
                "model",
                "store",
                "taskgraph",
                "stills",
                "providers",
                "artgen-adopt",
                "contracts"
              ],
              "artgen-adopt": [
                "types",
                "store",
                "taskgraph",
                "taskgraph-write",
                "taskgraph-maintain",
                "contracts"
              ],
              "git"               : ["util", "contracts"],
              "commands"          : ["types", "util", "git", "contracts"],
              "agentreport": [
                "types",
                "util",
                "config",
                "parse",
                "model",
                "store",
                "commands",
                "providers",
                "authoring",
                "contracts"
              ],
              "debug2d"           : ["contracts"],
              "taskgraph"         : ["types", "util", "store", "contracts", "taskgraph-write"],
              "taskgraph-write"   : ["types", "util", "store", "contracts"],
              "taskgraph-maintain": ["types", "util", "store", "taskgraph", "contracts"],
              "providers"         : ["types", "util", "config", "contracts"],
              "pipeline": [
                "types",
                "util",
                "config",
                "model",
                "store",
                "taskgraph",
                "providers",
                "artgen",
                "stills",
                "gengraph",
                "contracts"
              ],
              "gengraph": [
                "types",
                "util",
                "config",
                "model",
                "store",
                "taskgraph",
                "taskgraph-maintain",
                "artgen",
                "stills",
                "pathux",
                "contracts"
              ],
              "scheduler": [
                "types",
                "util",
                "config",
                "store",
                "taskgraph",
                "taskgraph-write",
                "pipeline",
                "contracts"
              ],
              "testkit": [
                "types",
                "util",
                "config",
                "parse",
                "model",
                "store",
                "export",
                "git",
                "commands",
                "taskgraph",
                "providers",
                "gengraph",
                "pipeline",
                "scheduler",
                "contracts"
              ],
              "authoring": [
                "types",
                "util",
                "config",
                "parse",
                "model",
                "store",
                "scriptedit",
                "bible",
                "artgen",
                "stills",
                "gengraph",
                "providers",
                "git",
                "contracts"
              ],
              "authoring-app": [
                "types",
                "util",
                "config",
                "store",
                "artgen",
                "providers",
                "git",
                "authoring",
                "contracts"
              ],
              "cli": [
                "types",
                "util",
                "config",
                "parse",
                "model",
                "store",
                "export",
                "taskgraph",
                "providers",
                "pipeline",
                "scheduler",
                "contracts"
              ],
              "desktop": [
                "types",
                "util",
                "config",
                "parse",
                "model",
                "store",
                "export",
                "scriptedit",
                "bible",
                "artgen",
                "stills",
                "gengraph",
                "git",
                "commands",
                "agentreport",
                "taskgraph",
                "taskgraph-maintain",
                "providers",
                "pipeline",
                "scheduler",
                "authoring",
                "debug2d",
                "pathux",
                "contracts"
              ]
            }
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/__fixtures__/**"],
      "rules": {
        "vn/element-types": "off"
      }
    },
    {
      "files": [
        "apps/desktop/src/main/session/**",
        "apps/desktop/src/main/runtime/**",
        "apps/desktop/renderer/pathux/**"
      ],
      "rules": {
        "vn/no-cycle": "warn"
      }
    }
  ],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/vendor/**",
    "**/.package/**",
    "**/win-unpacked/**"
  ]
}
