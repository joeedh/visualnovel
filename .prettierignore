**/dist/**
**/node_modules/**

# Submodules. path.ux has its own prettier config and its own repo; formatting it from here
# shows the gitlink as dirty and would fight its style on every pass.
vendor/**
# Machine-written desktop session state (see apps/desktop/src/main/sessionstore.ts).
# Prettier 3 doesn't read .gitignore, so it needs saying twice.
**/.vndesktop/**
pnpm-lock.yaml
coverage/**
keys/**

# The author's running list. Hand-written shorthand, deliberately not markdown checkboxes —
# reformatting it loses the shape it is kept in. See CLAUDE.md's Plans conventions.
todos.md

# Standalone, hand-authored design reference (compact single-line HTML/CSS kept on purpose).
# It's an artifact, not source — don't let prettier reflow it into thousands of lines.
apps/desktop/prototype.html

# Authored project inputs are serialized by @vn/parse's round-trip YAML front-matter writer
# and @vn/model's `docToMarkdown`, not prettier. A prettier pass here fails the scene
# round-trip test, which compares the serializer's output against these files byte for byte.
templates/**/characters/**
templates/**/locations/**
templates/**/scenes/**

# A run's output tree, written by @vn/store and @vn/pipeline. It's committed (it's the
# reproducible result of a run), but its writers own its formatting — a prettier pass here
# would show up as a spurious diff after every single run.
**/vngen/build/**
**/vngen/state/**
**/vngen/work/**

# The recorded fixture-art corpus. `index.json` is written by AssetCache on every re-record,
# so a prettier pass over it would be undone by the next one.
packages/testkit/assets/**
