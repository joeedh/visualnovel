# Normalize all text files to LF in the repo and on checkout, regardless of a
# contributor's core.autocrlf setting. Without this, autocrlf=true on Windows checks
# files out as CRLF, which conflicts with prettier's LF default and breaks `pnpm lint`.
* text=auto eol=lf

# Lockfile is generated; keep it LF and out of diffs' way.
pnpm-lock.yaml text eol=lf linguist-generated=true
